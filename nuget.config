<?xml version="1.0" encoding="utf-8"?>
<!-- Repositório público: CI roda no GitHub (ubuntu-latest). A dependência
     transitiva Sufficit.Gateway.Zabbix (10.x) exige Pomelo.
    .EntityFrameworkCore.MySql 10.0.0 — fork Sufficit que não existe no
     nuget.org. O nupkg versionado em pkg/ supre o restore; no nuget.org a
     versão publicada mais próxima é a 9.0.0 (upstream), insuficiente. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="sufficit-pomelo-fork" value="pkg" />
  </packageSources>
</configuration>
